# Server
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ctd_db
DB_USER=postgres
DB_PASSWORD=changeme

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=changeme
BETTER_AUTH_URL=http://localhost:3000

# Frontend origin(s) allowed to use auth cookies (comma-separated)
FRONTEND_URL=http://localhost:5173

# Trial policy (task #5): 5 GB for 24 hours
TRIAL_QUOTA_BYTES=5368709120
TRIAL_DURATION_HOURS=24

# Gateway provisioning — shared secret the operator puts on each gateway
# so it can self-register once and receive its API token
GATEWAY_PROVISIONING_TOKEN=changeme

# Seconds after the last heartbeat before a gateway reads as offline
GATEWAY_HEARTBEAT_TIMEOUT_SECONDS=90
